import { S3Client, PutBucketCorsCommand, GetBucketCorsCommand } from "@aws-sdk/client-s3";
import Credentials from "../config/Credentials.js";

async function setupB2Cors() {
  const s3Client = new S3Client({
    endpoint: `https://s3.us-east-005.backblazeb2.com`, // Adjust to your region if different
    region: "us-east-005",
    credentials: {
      accessKeyId: Credentials.B2_APPLICATION_KEY_ID,
      secretAccessKey: Credentials.B2_APPLICATION_KEY,
    },
  });

  try {
    console.log(`Updating CORS rules via S3 API for bucket: ${Credentials.B2_BUCKET_NAME}`);

    const command = new PutBucketCorsCommand({
      Bucket: Credentials.B2_BUCKET_NAME,
      CORSConfiguration: {
        CORSRules: [
          {
            AllowedHeaders: ["*"],
            AllowedMethods: ["GET", "PUT", "POST", "DELETE", "HEAD"],
            AllowedOrigins: ["*"],
            ExposeHeaders: ["ETag", "x-amz-request-id", "x-amz-id-2"],
            MaxAgeSeconds: 3600,
          },
        ],
      },
    });

    await s3Client.send(command);
    console.log("✅ CORS rules updated successfully via S3 API!");

    // Verification
    console.log("Verifying CORS rules...");
    const getCommand = new GetBucketCorsCommand({
      Bucket: Credentials.B2_BUCKET_NAME,
    });
    const response = await s3Client.send(getCommand);
    console.log("✅ Verified CORS Rules on B2:");
    console.log(JSON.stringify(response.CORSRules, null, 2));

  } catch (error) {
    console.error("❌ Failed to update CORS rules:");
    console.error(error.message);
    if (error.name === "NoSuchCORSConfiguration") {
        console.log("No CORS configuration exists yet, which is normal before the first setup.");
    }
  }
}

setupB2Cors();
