          .map((f) => f.filename)
          .join(", ")}]`
      );

      return res.json({
        ok: true,
        ...result,
      });
    } catch (err) {
      logger.error(
        `POST /orders/${req.params.orderId}/upload failed: ${err.stack || err}`
      );
      return res.status(500).json({ ok: false, message: "Server error" });
    }
  }
);

// GET /order/view?email=...  (public) - returns order images if email found
