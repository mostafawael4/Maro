{
    "$schema": "./node_modules/@angular/service-worker/config/schema.json",
    "index": "/index.html",
    "assetGroups": [
        {
            "name": "app",
            "installMode": "prefetch",
            "resources": {
                "files": [
                    "/favicon.ico",
                    "/index.html",
                    "/*.css",
                    "/*.js"
                ]
            }
        },
        {
            "name": "assets",
            "installMode": "lazy",
            "updateMode": "prefetch",
            "resources": {
                "files": [
                    "/assets/**",
                    "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
                ]
            }
        }
    ],
    "dataGroups": [
        {
            "name": "api-data",
            "urls": [
                "/api/homepage",
                "/api/gallery",
                "/api/films",
                "/api/orders/**"
            ],
            "cacheConfig": {
                "strategy": "freshness",
                "maxSize": 100,
                "maxAge": "1h",
                "timeout": "5s"
            }
        },
        {
            "name": "media-assets",
            "urls": [
                "https://*.backblazeb2.com/file/**"
            ],
            "cacheConfig": {
                "strategy": "performance",
                "maxSize": 500,
                "maxAge": "7d",
                "cacheQueryOptions": {
                    "ignoreVary": true
                }
            }
        }
    ]
}